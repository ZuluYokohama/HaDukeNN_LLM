{
  "enabled": true,
  "PreToolUse": [
    {
      "matcher": "^(write_to_file|replace_file_content|multi_replace_file_content)$",
      "hooks": [
        {
          "type": "command",
          "command": "python3 .agents/hooks/pre_tool_use_guard.py --event PreToolUse",
          "timeout": 30
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "python3 .agents/hooks/pre_tool_use_guard.py --event PostToolUse",
          "timeout": 30
        }
      ]
    }
  ],
  "Stop": [
    {
      "type": "command",
      "command": "python3 .agents/hooks/pre_tool_use_guard.py --event Stop",
      "timeout": 30
    }
  ],
  "SessionStart": [
    {
      "type": "command",
      "command": "python3 .agents/hooks/pre_tool_use_guard.py --event SessionStart",
      "timeout": 30
    }
  ]
}
