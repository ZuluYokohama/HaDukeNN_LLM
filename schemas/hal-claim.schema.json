{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sheaf-verify.hal-claim.v1",
  "type": "object",
  "required": ["format", "study_profile", "hypothesis_id", "description", "performance"],
  "properties": {
    "format": {"const": "sheaf-verify.hal-claim.v1"},
    "study_profile": {"const": "hal"},
    "hypothesis_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 20},
    "performance": {
      "type": "object",
      "required": ["metric", "direction", "baseline", "baselines_reported", "min_speedup", "subject"],
      "properties": {
        "metric": {"const": "speedup"},
        "direction": {"const": "greater"},
        "baseline": {"enum": ["serial_python_loop", "packed_numpy"]},
        "baselines_reported": {"type": "array", "items": {"type": "string"}},
        "min_speedup": {"type": "number", "exclusiveMinimum": 0},
        "subject": {"const": "c11_tiled_cce"}
      }
    },
    "parity": {
      "type": "object",
      "properties": {
        "max_abs": {"type": "number", "exclusiveMinimum": 0},
        "ops": {"type": "array", "items": {"type": "string"}}
      }
    },
    "guards": {
      "type": "object",
      "properties": {"thermal_stop_celsius": {"type": "number"}}
    }
  }
}
