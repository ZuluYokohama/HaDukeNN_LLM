{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sheaf-verify.scitt-merkle-receipt.v1",
  "type": "object",
  "required": [
    "format",
    "gate_id",
    "leaf_index",
    "tree_size",
    "record_sha256",
    "merkle_root_sha256",
    "audit_path",
    "record"
  ],
  "properties": {
    "format": {"const": "sheaf-verify.scitt-merkle-receipt.v1"},
    "gate_id": {"type": "string"},
    "leaf_index": {"type": "integer", "minimum": 0},
    "tree_size": {"type": "integer", "minimum": 1},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "merkle_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "audit_path": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "record": {"type": "object"},
    "dsse": {"type": "object"}
  }
}
