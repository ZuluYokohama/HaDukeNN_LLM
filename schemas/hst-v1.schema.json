{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZuluYokohama/HaDukeNN_LLM/schemas/hst-v1.schema.json",
  "title": "HaDukeNN Span-Trace Tokenization Standard Manifest (HST-v1)",
  "type": "object",
  "required": [
    "schema",
    "version",
    "vocab_size",
    "n_byte_tokens",
    "max_span_bytes",
    "digit_atomic_policy",
    "stage_a_merges",
    "stage_b_superspans",
    "control_tokens",
    "merges",
    "merkle_root_sha256"
  ],
  "properties": {
    "schema": { "const": "hadukenn.hst.manifest.v1" },
    "version": { "type": "string" },
    "vocab_size": { "type": "integer", "minimum": 264 },
    "n_byte_tokens": { "type": "integer", "minimum": 256 },
    "max_span_bytes": { "type": "integer", "minimum": 1, "maximum": 64 },
    "digit_atomic_policy": { "const": true },
    "stage_a_merges": { "type": "integer", "minimum": 0 },
    "stage_b_superspans": { "type": "integer", "minimum": 0 },
    "control_tokens": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 256 }
    },
    "merges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["token_id", "left_id", "right_id", "stage", "pmi_bits", "count", "byte_len", "token_b64"],
        "properties": {
          "token_id": { "type": "integer", "minimum": 256 },
          "left_id": { "type": "integer", "minimum": 0 },
          "right_id": { "type": "integer", "minimum": 0 },
          "stage": { "enum": ["A_lexical", "B_superspan"] },
          "pmi_bits": { "type": "number" },
          "count": { "type": "integer", "minimum": 1 },
          "byte_len": { "type": "integer", "minimum": 2 },
          "token_b64": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "merkle_root_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
